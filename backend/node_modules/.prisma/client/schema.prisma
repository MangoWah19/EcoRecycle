generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum MissionType {
  QUANTITY_BASED
  STREAK_BASED
  TIME_LIMITED
}

enum MissionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
}

enum BadgeCriteriaType {
  MISSIONS_COMPLETED
  QUIZZES_PASSED
  CONTENT_COMPLETED
  ACTIVITY_METRIC
}

enum PointsEventStatus {
  PENDING
  SENT
  FAILED
}

enum PointsEventType {
  MISSION_APPROVED
}

enum UploadPurpose {
  MISSION_PROOF
}

model User {
  id              String              @id
  name            String
  email           String              @unique
  passwordHash    String
  role            Role                @default(STUDENT)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  submissions     MissionSubmission[]
  reviewedItems   MissionSubmission[] @relation("SubmissionReviewer")
  contentCreated  Content[]           @relation("ContentCreator")
  missionCreated  Mission[]           @relation("MissionCreator")
  quizAttempts    QuizAttempt[]
  badgeAwards     BadgeAward[]
  progressRecords LearningProgress[]
  pointsEvents    PointsEvent[]
  uploads         UploadedFile[]
}

model Mission {
  id            String              @id
  slug          String              @unique
  title         String
  description   String
  type          MissionType
  startAt       DateTime
  endAt         DateTime
  submissionCap Int?
  points        Int
  autoApprove   Boolean             @default(false)
  isActive      Boolean             @default(true)
  status        MissionStatus       @default(DRAFT)
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdBy     User                @relation("MissionCreator", fields: [createdById], references: [id])
  submissions   MissionSubmission[]
  pointsEvents  PointsEvent[]

  @@index([status, startAt, endAt])
  @@index([isActive])
}

model MissionSubmission {
  id            String           @id
  missionId     String
  userId        String
  proofText     String?
  proofImageUrl String?
  quantity      Int?
  status        SubmissionStatus @default(PENDING_REVIEW)
  reviewNote    String?
  reviewedById  String?
  submittedAt   DateTime         @default(now())
  reviewedAt    DateTime?
  mission       Mission          @relation(fields: [missionId], references: [id])
  user          User             @relation(fields: [userId], references: [id])
  reviewedBy    User?            @relation("SubmissionReviewer", fields: [reviewedById], references: [id])
  pointsEvents  PointsEvent[]
  uploads       UploadedFile[]

  @@index([missionId, userId, submittedAt])
  @@index([status, submittedAt])
}

model PointsEvent {
  id            String             @id
  userId        String
  missionId     String?
  submissionId  String?            @unique
  points        Int
  eventType     PointsEventType
  status        PointsEventStatus  @default(PENDING)
  approvedAt    DateTime
  lastAttemptAt DateTime?
  errorMessage  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id])
  mission       Mission?           @relation(fields: [missionId], references: [id])
  submission    MissionSubmission? @relation(fields: [submissionId], references: [id])

  @@index([status, createdAt])
}

model Content {
  id              String             @id
  slug            String             @unique
  title           String
  body            String
  tags            String[]
  status          ContentStatus      @default(DRAFT)
  version         Int                @default(1)
  createdById     String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdBy       User               @relation("ContentCreator", fields: [createdById], references: [id])
  quizzes         Quiz[]
  revisions       ContentRevision[]
  progressRecords LearningProgress[]
}

model ContentRevision {
  id        String        @id
  contentId String
  version   Int
  title     String
  body      String
  tags      String[]
  status    ContentStatus
  createdAt DateTime      @default(now())
  content   Content       @relation(fields: [contentId], references: [id])

  @@index([contentId, version])
}

model Quiz {
  id           String         @id
  contentId    String
  slug         String         @unique
  title        String
  passingScore Int            @default(70)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  content      Content        @relation(fields: [contentId], references: [id])
  questions    QuizQuestion[]
  attempts     QuizAttempt[]
}

model QuizQuestion {
  id            String   @id
  quizId        String
  code          String   @unique
  questionText  String
  options       String[]
  correctAnswer String
  points        Int      @default(1)
  quiz          Quiz     @relation(fields: [quizId], references: [id])
}

model QuizAttempt {
  id             String   @id
  quizId         String
  userId         String
  score          Int
  totalQuestions Int
  correctAnswers Int
  passed         Boolean
  answers        Json
  attemptedAt    DateTime @default(now())
  quiz           Quiz     @relation(fields: [quizId], references: [id])
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId, attemptedAt])
}

model Badge {
  id                  String            @id
  slug                String            @unique
  name                String
  description         String
  tier                BadgeTier
  criteriaType        BadgeCriteriaType
  criteriaValue       Int
  criteriaReferenceId String?
  criteriaReference   String?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  awards              BadgeAward[]
}

model BadgeAward {
  id        String   @id
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId, awardedAt])
}

model LearningProgress {
  id                String   @id
  userId            String
  contentId         String
  completed         Boolean  @default(false)
  completionCount   Int      @default(0)
  quizAttemptsCount Int      @default(0)
  passedQuizCount   Int      @default(0)
  latestScore       Int?
  lastActivityAt    DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
  content           Content  @relation(fields: [contentId], references: [id])

  @@unique([userId, contentId])
  @@index([userId, lastActivityAt])
}

model UploadedFile {
  id                  String             @id
  userId              String
  missionSubmissionId String?
  containerName       String
  blobName            String
  fileUrl             String
  mimeType            String
  fileSize            Int
  purpose             UploadPurpose
  createdAt           DateTime           @default(now())
  user                User               @relation(fields: [userId], references: [id])
  missionSubmission   MissionSubmission? @relation(fields: [missionSubmissionId], references: [id])
}
